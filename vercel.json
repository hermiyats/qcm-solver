{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": null,
  "framework": null,
  "functions": {
    "api/index.ts": { "maxDuration": 60 },
    "api/health.ts": { "maxDuration": 10 }
  },
  "routes": [
    { "src": "^/api$", "dest": "/api/index" },
    { "src": "^/api/health$", "dest": "/api/health" },
    { "src": "^/api/.*", "status": 404 }
  ]
}
