# Environment variables for the middle-layer API.
# On Vercel, set these in: Project → Settings → Environment Variables.
# For local `vercel dev`, copy this to `.env` (it is gitignored).

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...
# QCM_ENDPOINT is for the desktop client only (not used server-side).

# Required: shared secret that authorises desktop clients. Generate with
#   openssl rand -hex 32
# The desktop app must send the same value (QCM_ACCESS_TOKEN env var or the
# Token field). Requests without it are rejected with 401.
QCM_ACCESS_TOKEN=

# Optional overrides.
# QCM_MODEL=claude-opus-4-8
# QCM_MAX_TOKENS=16000
