# Environment variables for the middle-layer API.
# On Vercel, set these in: Project → Settings → Environment Variables.
# For local `vercel dev`, copy this to `.env` (it is gitignored).

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
# QCM_MODEL=claude-opus-4-8
# QCM_MAX_TOKENS=16000
